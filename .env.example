# ── Shared ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transcribe

# Storage: "local" (files on disk, single-machine dev) or "s3" (R2/MinIO/S3)
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads          # local driver only (path is resolved per-service)
S3_ENDPOINT=http://localhost:9000  # s3 driver: MinIO in dev, R2/S3 in prod
S3_REGION=auto
S3_BUCKET=transcribe
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_FORCE_PATH_STYLE=1              # 1 for MinIO, usually 0 for AWS S3

# ── Web (Next.js) ─────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=                 # sk_test_... (leave empty to disable Stripe)
STRIPE_WEBHOOK_SECRET=             # whsec_...
DEV_FAKE_CHECKOUT=0                # 1 = "buy" buttons credit instantly (dev only, no Stripe)

# ── Worker (Python) ───────────────────────────────────────────────────────────
# Each tier picks a backend + model. Defaults: Standard → Groq (cheap, fast,
# ~99 languages); Premium → AssemblyAI (long-form accuracy).
STANDARD_BACKEND=groq              # groq | assemblyai | local | fake
STANDARD_MODEL=whisper-large-v3-turbo
PREMIUM_BACKEND=assemblyai         # groq | assemblyai | local | fake
PREMIUM_MODEL=best                 # AssemblyAI speech_model (verify current name in their docs)

# Set to force every tier onto one backend (overrides the per-tier settings).
# Useful for a fully self-hosted setup (local) or tests (fake).
TRANSCRIBE_BACKEND=

# Groq (OpenAI-compatible speech-to-text)
GROQ_API_KEY=                      # console.groq.com

# AssemblyAI
ASSEMBLYAI_API_KEY=                # assemblyai.com
ASSEMBLYAI_TIMEOUT_SECONDS=3600

# Self-hosted faster-whisper (only used when a tier's backend is "local")
WHISPER_DEVICE=auto                # auto | cpu | cuda
WHISPER_COMPUTE=auto               # auto | int8 | float16 | ...
WHISPER_MODEL_STANDARD=small       # faster-whisper model for the standard tier
WHISPER_MODEL_PREMIUM=large-v3     # faster-whisper model for the premium tier

MAX_DURATION_SECONDS=14400         # reject media longer than 4h
MAX_FILESIZE_BYTES=2147483648      # 2 GB cap for uploads & URL downloads
POLL_INTERVAL_SECONDS=2
STALE_JOB_MINUTES=30               # requeue jobs stuck in a running state this long
SSRF_ALLOW_PRIVATE=0               # 1 = allow private-network URLs (dev/testing ONLY)
