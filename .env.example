# ── Shared ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transcribe

# Storage: "local" (files on disk, single-machine dev) or "s3" (R2/MinIO/S3)
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads          # local driver: shared by web+worker; relative paths resolve against the repo root (use an absolute path in production)
S3_ENDPOINT=http://localhost:9000  # s3 driver: MinIO in dev, R2/S3 in prod
S3_REGION=auto
S3_BUCKET=transcribe
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_FORCE_PATH_STYLE=1              # 1 for MinIO, usually 0 for AWS S3

# ── Web (Next.js) ─────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=                 # sk_test_... (leave empty to disable Stripe)
STRIPE_WEBHOOK_SECRET=             # whsec_...
STRIPE_AUTOMATIC_TAX=0             # 1 = ask Stripe Checkout to calculate tax (configure Stripe Tax first)
DEV_FAKE_CHECKOUT=0                # 1 = "buy" buttons credit instantly (dev only, no Stripe)

# Public operator and contact details shown on legal, billing, and support pages.
# Configure these before accepting sign-ups or payments; do not use placeholders in production.
LEGAL_ENTITY_NAME=
SUPPORT_EMAIL=
PRIVACY_EMAIL=

# Transactional email (password reset & email verification) via Resend.
# Leave RESEND_API_KEY empty in dev to log emails to the server console instead
# of sending them.
RESEND_API_KEY=                    # re_... from resend.com
EMAIL_FROM="Transcribe <onboarding@resend.dev>"  # a verified sender on your Resend domain

# Developer portal (/developer): comma-separated emails allowed to view business stats.
ADMIN_EMAILS=
# Cost assumptions used only for direct-contribution estimates in the developer portal.
STRIPE_FEE_PCT=2.9                 # Stripe % fee per sale
STRIPE_FEE_FIXED_CENTS=30          # Stripe fixed fee per sale, in cents
EST_COST_PER_CREDIT_CENTS=0.1      # your estimated transcription cost per credit, in cents

# ── Worker (Python) ───────────────────────────────────────────────────────────
# Standard tier = Groq Whisper Large V3 Turbo. Premium tier = Soniox async v5.
STANDARD_MODEL=whisper-large-v3-turbo
PREMIUM_MODEL=stt-async-v5

# Leave empty to use the hosted Groq/Soniox routes. `fake` is available only
# for local testing; it does not contact either API.
TRANSCRIBE_BACKEND=

# Groq (OpenAI-compatible speech-to-text)
GROQ_API_KEY=                      # console.groq.com
GROQ_MAX_UPLOAD_BYTES=104857600    # 100 MB developer-tier limit; use 26214400 for Groq Free

# Soniox asynchronous speech-to-text
SONIOX_API_KEY=                    # console.soniox.com
SONIOX_BASE_URL=https://api.soniox.com/v1
SONIOX_TIMEOUT_SECONDS=3600
SONIOX_POLL_SECONDS=1

AUDIO_RETENTION_DAYS=7             # retained playable audio; 0 disables retention (source uploads are still deleted after processing)
MAX_DURATION_SECONDS=14400         # reject media longer than 4h
MAX_BATCH_DURATION_SECONDS=86400   # 24h maximum confirmed audio across one playlist
MAX_FILESIZE_BYTES=2147483648      # 2 GB cap for uploads & URL downloads
MAX_ACTIVE_JOBS_PER_USER=3         # concurrent transcriptions per account
MAX_JOB_SUBMISSIONS_PER_HOUR=30    # shared per-account/IP creation limit (URL + upload)
MAX_PENDING_UPLOADS_PER_USER=3     # unclaimed upload slots per verified account
MAX_OPEN_BATCHES_PER_USER=3        # playlists waiting for expansion/review
MAX_PLAYLIST_ITEMS=100             # reject, never silently truncate, larger playlists
MEDIA_COMMAND_TIMEOUT_SECONDS=1800 # max seconds for one ffmpeg operation
POLL_INTERVAL_SECONDS=2
STALE_JOB_MINUTES=30               # requeue jobs stuck in a running state this long
SSRF_ALLOW_PRIVATE=0               # 1 = allow private-network URLs (dev/testing ONLY)
